\newlabel{methods}{{1}{1}{}{Doc-Start}{}}
\@writefile{snm}{\beamer@slide {methods}{1}}
\newlabel{fig:map}{{1}{1}{Spatial delineation of GLAHF subregions and selected met station locations (GHCND\supercite {Menne2012}, ISD\supercite {Smith2011}). The upper right figure shows depth and (relative) surface area of each subregion in the y and x directions, respectively}{Doc-Start}{}}
\@writefile{snm}{\beamer@slide {fig:map}{1}}
\newlabel{analysis}{{1}{1}{}{Doc-Start}{}}
\@writefile{snm}{\beamer@slide {analysis}{1}}
\newlabel{fig:dur}{{2}{1}{Evolution of one of three metrics analyzed (ice duration) for each subregion}{Doc-Start}{}}
\@writefile{snm}{\beamer@slide {fig:dur}{1}}
\newlabel{fig:trends}{{3}{1}{Linear trends for each metric. Open (solid) dots indicate 95\% (99\%) statistical significance. Columns correspond to rows in fig \ref {fig:dur}}{Doc-Start}{}}
\@writefile{snm}{\beamer@slide {fig:trends}{1}}
\newlabel{fig:boxplot}{{4}{1}{Correlations between statisitically significant ice metric trends (vertical axes) and morphometrics (horizontal axes). Moderate correlations (pearson's r$>$0.3) are shown in dark grey and strong correlations ($>$0.6) are black}{Doc-Start}{}}
\@writefile{snm}{\beamer@slide {fig:boxplot}{1}}
\newlabel{fig:scatter}{{5}{1}{Correlation between Seasonal Ice Cover (JFM) and local meteorology. Meteorological variables are aggregated by month (columns) and state variable (rows). Larger squares indicate stronger correlations and blue (red) indicates direct (indirect) correlation}{Doc-Start}{}}
\@writefile{snm}{\beamer@slide {fig:scatter}{1}}
