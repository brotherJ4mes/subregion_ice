\newlabel{fig:scatter}{{5}{1}{Correlation between Seasonal Ice Cover (JFM) and local meteorology. Meteorological variables are aggregated by month (columns) and state variable (rows). Larger squares indicate stronger correlations and blue (red) indicates direct (indirect) correlation}{Doc-Start}{}}
\@writefile{snm}{\beamer@slide {fig:scatter}{1}}
