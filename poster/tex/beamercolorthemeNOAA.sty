% \ProvidesPackage{beamerthemeUTAustin}

% % Load the base theme
% \usepackage{beamerthemeshadow}

% Define NOAA (and UT Austin colors)
\definecolor{NOAA_dark_blue}{HTML}{093a7a}
\definecolor{NOAA_light_blue}{HTML}{0175af}
\definecolor{UTLightGray}{HTML}{E4E4E4}
\definecolor{UTWhite}{HTML}{FFFFFF}
\definecolor{black}{HTML}{000000}


% Background and foreground
\setbeamercolor{background canvas}{bg=UTWhite}
\setbeamercolor{normal text}{fg=black}
\setbeamercolor{alerted text}{fg=NOAA_dark_blue}

% Title and sections
\setbeamercolor{frametitle}{fg=UTWhite, bg=NOAA_dark_blue}
\setbeamercolor{title}{fg=UTWhite, bg=NOAA_dark_blue}
\setbeamercolor{section in toc}{fg=NOAA_dark_blue, bg=UTLightGray}

% Blocks
\setbeamercolor{block title}{fg=UTWhite, bg=NOAA_dark_blue}
\setbeamercolor{block body}{fg=black, bg=UTWhite}

\setbeamercolor{block title alert}{fg=UTWhite, bg=black}
\setbeamercolor{block body alert}{fg=black, bg=NOAA_light_blue}
%\setbeamercolor{block title example}{fg=UTWhite, bg=black}
%\setbeamercolor{block body example}{fg=black, bg=UTWhite}

% Itemize, enumerate, etc.
\setbeamercolor{item projected}{bg=NOAA_dark_blue, fg=UTWhite}
\setbeamercolor{enumerate item}{fg=NOAA_dark_blue}

% Navigation symbols (optional)
\setbeamercolor{navigation symbols dimmed}{fg=black}
\setbeamercolor{navigation symbols}{fg=NOAA_dark_blue}

% Additional styling
\setbeamercolor{subsection in toc}{fg=black, bg=UTLightGray}
\setbeamercolor{frametitle continuation}{fg=UTWhite, bg=black}

% Footer and headline
\setbeamercolor{headline}{fg=UTWhite, bg=NOAA_dark_blue}
\setbeamercolor{footline}{fg=UTWhite, bg=NOAA_dark_blue}
\setbeamercolor{headline_p2}{bg=NOAA_light_blue}
\setbeamercolor{title in head/foot}{fg=UTWhite, bg=NOAA_dark_blue}
\setbeamercolor{author in head/foot}{fg=UTWhite, bg=black}

